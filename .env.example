# Site
NEXT_PUBLIC_SITE_URL=https://saadanqasmani.com

# Supabase. Every one of these is read on the server only: the public pages,
# the admin session, the middleware. Nothing here reaches a visitor's browser,
# so none of them wants a NEXT_PUBLIC_ prefix. The prefixed spellings are
# still accepted, for a project already set up that way.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# The master key. It bypasses every row-level security rule in the database,
# so it belongs in the hosting provider's environment screen and nowhere
# else: never in this file with a real value, never in a screenshot, and
# never behind a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Email delivery, through Resend. Without a key the site still takes
# subscriptions; it just does not write back to them.
RESEND_API_KEY=

# Who the welcome letter comes from. The address must sit on the domain
# verified with Resend. It is deliberately the send. subdomain and not the
# apex, so the mailbox already living on the apex keeps its own SPF.
MAIL_FROM="Saadan Qasmani <hello@send.saadanqasmani.com>"

# Where a reply should land: a mailbox that is actually read. Nothing
# collects mail on the sending subdomain. Left unset, no Reply-To is sent.
MAIL_REPLY_TO=

# Comma-separated emails allowed into /admin
ADMIN_EMAILS=

# Access code for the IRIS explainer film and the two sections that describe
# how it works. Change it here (or in the host's environment) to rotate it
# without a code change. Defaults to the code Saadan hands out today.
IRIS_FILM_CODE=

# Access code for the essays and notes. Subscribers are emailed this.
# Change it here to rotate it without a deploy.
JOURNAL_CODE=
